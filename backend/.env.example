# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=wealy_jwt_secret_key_development_2026
JWT_EXPIRES_IN=7d

# Supabase Configuration (Sesuai Bab II Modul Praktikum)
# Dapatkan dari: Supabase Dashboard -> Project Settings -> Data API / API Keys
# Project URL:
SUPABASE_URL=https://your-project.supabase.co
# anon public key:
SUPABASE_KEY=your-supabase-anon-key

# Cloudinary Configuration (Penyimpanan Foto Wardrobe)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=wealy_wardrobe
